#!/bin/sh

# the jailbreak root differs per scheme:
#   rootful:  /
#   rootless: /var/jb
#   roothide: /var/containers/Bundle/Application/.jbroot-XXXXXXXXXXXXXXXX
JBROOT=""
if [ ! -f "/Applications/TweakSettings.app/TweakSettings" ]; then
    if command -v jbroot >/dev/null 2>&1; then
        JBROOT=$(jbroot / 2>/dev/null | sed 's:/*$::')
    fi

    if [ -z "$JBROOT" ] || [ ! -f "$JBROOT/Applications/TweakSettings.app/TweakSettings" ]; then
        JBROOT=/var/jb
    fi

    if [ ! -f "$JBROOT/Applications/TweakSettings.app/TweakSettings" ]; then
        for ROOT in /var/containers/Bundle/Application/.jbroot-*; do
            if [ -f "$ROOT/Applications/TweakSettings.app/TweakSettings" ]; then
                JBROOT=$ROOT
                break
            fi
        done
    fi
fi

UTILITY=$JBROOT/usr/bin/tweaksettings-utility
if [ -f "$UTILITY" ]; then
    chown root:wheel "$UTILITY"
    chmod 0777 "$UTILITY"
    chmod +s "$UTILITY"
    echo "set $UTILITY permissions"
fi

APP_FOLDER=$JBROOT/Applications/TweakSettings.app
APP=$APP_FOLDER/TweakSettings
if [ -f "$APP" ]; then
    chown root:wheel "$APP"
    chmod 0755 "$APP"
    echo "set $APP permissions"
fi

if [ -d "$APP_FOLDER" ]; then
    uicache -p "$APP_FOLDER" >/dev/null 2>&1 || true
    echo "registered $APP_FOLDER"
fi

exit 0;
